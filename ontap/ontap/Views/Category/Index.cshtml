@model IEnumerable<ontap.Models.Category>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<form asp-action="Index" method="get">
    <p>
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" />
        <input type="hidden" name="currentFilter" value="@ViewData["CurrentFilter"]" />
        <input type="submit" value="Search" />

    </p>
</form>
<p>
    Sap xep:
    <a asp-action="Index"
       asp-route-searchString="@ViewData["CurrentFilter"]"
       asp-route-sortOrder="name_asc">Sap xep theo ten (A-Z)</a>
    |
    <a asp-action="Index"
       asp-route-searchString="@ViewData["CurrentFilter"]"
       asp-route-sortOrder="name_desc">Sap xep theo ten (Z-A)</a>
    |
    <a asp-action="Index"
       asp-route-searchString="@ViewData["CurrentFilter"]"
       asp-route-sortOrder="id_asc">Sap xep theo id tang</a>
    |
    <a asp-action="Index"
       asp-route-searchString="@ViewData["CurrentFilter"]"
       asp-route-sortOrder="id_desc">Sap xep theo id giam</a>
</p>
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CategoryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CategoryDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Products)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.CategoryName)
            </td>
            <td>
                @Html.DisplayFor(model => item.CategoryDescription)
            </td>
            <td>
                @Html.DisplayFor(model => item.Products)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CategoryId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CategoryId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CategoryId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
<div>
    @for (int i = 1; i <= ViewBag.TotalPages; i++)
    {
        <a asp-action="Index"
           asp-route-pageNumber="@i"
           asp-route-searchString="@ViewBag.CurrentFilter"
           asp-route-sortOrder="@ViewBag.SortOrder">
            @i
        </a>
        <span> | </span>
    }
</div>